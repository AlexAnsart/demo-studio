# Copy to .env and fill in what you use. Never commit the real .env file.

# Only needed if demo.config.json → narration.provider is "elevenlabs".
# Get a key at https://elevenlabs.io — without it, demo-studio still produces
# a fully captioned, silent-narration-free video.
ELEVENLABS_API_KEY=

# Only needed if demo.config.json → auth.loginRequired is true and your demo
# script logs in as a test user. Never use real/production credentials here.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
